{
  "name": "homepage",
  "private": true,
  "scripts": {
    "start": "webpack serve --config ./webpack.dev.ts",
    "start:functions": "bun run build && wrangler pages dev dist",
    "build": "webpack --config ./webpack.prod.ts",
    "analyze": "webpack --config ./webpack.analyze.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:browser": "vitest --browser=chrome ",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --fix src",
    "format:check": "prettier --check",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "rm -rf node_modules/webpack-dev-middleware/node_modules/schema-utils"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "d3": "^7.9.0",
    "d3-simple-slider": "^2.0.0",
    "framer-motion": "^12.34.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260217.0",
    "@eslint/js": "^9.39.2",
    "@rsdoctor/webpack-plugin": "^1.5.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "bun-types": "latest",
    "copy-webpack-plugin": "^13.0.1",
    "esbuild-loader": "^4.4.2",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "happy-dom": "^20.6.1",
    "html-webpack-plugin": "^5.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1",
    "wrangler": "^4.65.0"
  }
}
